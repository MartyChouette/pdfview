<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PdfView</RootNamespace>
    <AssemblyName>pdfview</AssemblyName>
    <ApplicationIcon>pdfview.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>pdfview</Product>
    <AssemblyTitle>pdfview</AssemblyTitle>
    <FileDescription>pdfview - PDF viewer</FileDescription>
    <Company>pdfview</Company>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Startup. WinForms' first-touch cost is almost all JIT, so the framework
         and this assembly are compiled ahead of time. Not composite: that mode
         is marginally faster warm but links the whole framework into one 87 MB
         image, and the first launch after install then waits on the virus
         scanner reading all of it. Measured at 6.2 s against 2.1 s. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window icon is read back out of the executable at run time. -->
    <EmbeddedResource Include="pdfview.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The viewer front end ships beside the executable. -->
    <Content Include="..\..\app\**\*" LinkBase="app\" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\vendor\**\*" LinkBase="vendor\" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
